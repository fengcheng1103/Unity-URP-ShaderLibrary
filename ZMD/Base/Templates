Shader "Custom/Endfield_Base"
{
     Properties
     {
         [Header(RenderingMode)]
         [Enum(UnityEngine.Rendering.CullMode)]_Cull("CullType：剔除模式", int) = 0
         
         [Header(Albedo)]
         _AlbedoColor   ("基础色", Color) = (1.0, 1.0, 1.0, 1.0)
         [NoScaleOffset]
         [NoScaleOffset]_AlbedoMap   ("基础色贴图", 2D) = "white" {}
         _AlbedoStrength           ("基础色亮部强度", Range(0.0, 10.0)) = 1.0
         _AlbedoDarkStrength           ("基础色暗部强度", Range(0.0, 1.0)) = 1.0
