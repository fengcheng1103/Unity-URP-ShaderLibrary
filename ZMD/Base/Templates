         [Space(10)]
         [NoScaleOffset]_RMOMap   ("RMO贴图", 2D) = "white" {}
         _MetallicStrength        ("金属度", Range(0.0, 1.0)) = 1.0
         _RoughnessStrength       ("粗糙度", Range(0.0, 1.0)) = 1.0
         _OcclusionStrength       ("AO强度", Range(0.0, 1.0)) = 1.0
         
         [Space(10)]
