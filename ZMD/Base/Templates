         [HDR]_EffectsColor     ("特效颜色", Color) = (0.0, 0.0, 0.0, 0.0)
         
         [Space(10)]
         [NoScaleOffset]_RimLightMap   ("特效贴图", 2D) = "white" {}
         [HDR]_RimLightColor     ("边缘光颜色", Color) = (0.0, 0.0, 0.0, 0.0)
         _DepthRimOffset       ("边缘光偏移", Range(-2.0, 2.0)) = 1.0
         _DepthRimIntensity       ("边缘光强度", Range(0.0, 1.0)) = 1.0
         _FresnelRimOffset       ("边缘补光偏移", Range(-2.0, 2.0)) = 1.0
         _FresnelRimPower       ("边缘补光范围", Range(0.0, 100.0)) = 1.0
         _FresnelRimIntensity       ("边缘补光强度", Range(0.0, 1.0)) = 1.0
         _DepthRimLerp       ("边缘光混合基础色", Range(0.0, 1.0)) = 1.0
         _RimLightDirection       ("边缘光方向", Vector) = (0.0, 0.0, 0.0, 0.0)
         _RimMaskSoftness       ("遮罩软硬", Range(0.0, 1.0)) = 1.0
         _RimMaskOffset       ("遮罩偏移", Range(-1.0, 1.0)) = 1.0
         
         
         [Space(10)]
         [Toggle]_SpecularRefineEnable   ("高光修正开关", int) = 0
         _SpecularRefineMap  ("高光修正贴图", 2D) = "white" {}
         _SpecularRefineRamp       ("高光修正渐变", Range(0.0, 1.0)) = 1.0
         _SpecularRefineIntensity       ("高光修正强度", Range(0.0, 1.0)) = 1.0
         
         [Space(10)]
         [Toggle]_ApplyLutEnable   ("应用Lut开关", int) = 0
         [NoScaleOffset]_LutMap  ("LutMap", 2D) = "white" {}
         _LutStrength       ("Lut强度", Range(0.0, 1.0)) = 1.0
         
         [Space(10)]
         [HDR] _EnvColor     ("环境光颜色", Color) = (0.0, 0.0, 0.0, 0.0)
         _EnvLightStrength       ("环境强度", Range(0.0, 1.0)) = 1.0
         _EnvRotation       ("环境光旋转", Vector) = (0.0, 0.0, 0.0, 0.0)
         
         [Space(10)]
         _ShadowStrength           ("阴影强度", Range(0.0, 1.0)) = 1.0
         
         [Space(10)]
         _OutLineMask    ("描边遮罩", 2D) = "white"{}
         _OutlineColor                       ("描边颜色", Color) = (0.0, 0.0, 0.0, 1.0)
         _OutlineWidthMapStrength                     ("描边遮罩强度", Range(0 ,1)) = 1.0
         _OutlineWidth                     ("描边宽度", Float) = 0.01
         _OutlineZOffset                     ("描边Z轴偏移", Range(-1 ,1)) = 0.0
         
         [HideInInspector] _StencilRef("Stencil Ref", Float) = 1
     }
    
     SubShader
     {
         Tags       
         { 
            "RenderPipeline"="UniversalPipeline"
            "RenderType"="Opaque" 
            "Queue"="Geometry"
         }

         Cull [_Cull]

         Pass
         {
             Tags { "LightMode" = "UniversalForward" }
             
             Stencil
             {
                 Ref [_StencilRef]
                 Comp Always
                 Pass Replace
             }
             
             HLSLPROGRAM
             #pragma vertex vert
             #pragma fragment frag
             #pragma multi_compile _ _MAIN_LIGHT_SHADOWS
             #pragma multi_compile _ _MAIN_LIGHT_SHADOWS_CASCADE
             #pragma multi_compile _ _SHADOWS_SOFT
             #pragma shader_feature _ _APPLYLUTENABLE_ON
             #pragma shader_feature _ _EFFECTSENABLE_ON
             #pragma shader_feature _ _SPECULARREFINEENABLE_ON
             #pragma multi_compile _ _DEBUG_ALBEDO _DEBUG_NORMAL _DEBUG_METALLIC _DEBUG_ROUGHNESS _DEBUG_EMISSIVE _DEBUG_DIRECT_DIFFUSE _DEBUG_DIRECT_SPECULAR _DEBUG_INDIRECT_DIFFUSE _DEBUG_INDIRECT_SPECULAR _DEBUG_RIMLIGHT _DEBUG_AO _DEBUG_SHADOW
             #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
             #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
             #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Shadows.hlsl"
             #include "ZmdCommon.hlsl"
 
             struct Attributes
             {
                 float4 positionOS : POSITION;
                 half4 normalOS    : NORMAL;
                 half4 color       : COLOR;
                 half4 tangentOS   : TANGENT;
                 half2 texcoord0   : TEXCOORD0;
                 half2 texcoord1   : TEXCOORD1;
             };
 
             struct Varyings
             {
                 float4 positionCS : SV_POSITION;
                 half4 color       : COLOR;
                 float4 positionWS : TEXCOORD0;
                 float4 positionOS : TEXCOORD1;
                 float3 positionVS : TEXCOORD2;
                 half4 normalWS    : TEXCOORD3;
                 half3 tangentWS   : TEXCOORD4;
                 half4 uv0         : TEXCOORD5;
                 float3x3 TBN      : TEXCOORD6;
                 float4 shadowCoord : TEXCOORD9;
             };
 
             CBUFFER_START(UnityPerMaterial)
             half4 _AlbedoColor;
             half _AlbedoStrength;
             half _AlbedoDarkStrength;
             half _AlbedoDarkSaturation;
             half _NormalStrength;
             half _MetallicStrength;
             half _RoughnessStrength;
             half _OcclusionStrength;
             half _RampStrength;
             half3 _EmissionColor;
             half _EffectsEnable;
             half4 _EffectsColor;
 
             half4 _DepthRimColor;
             float _DepthRimOffset;
             float _DepthRimIntensity;
             half _DepthRimLerp;
             half4 _RimLightColor;
             half _FresnelRimOffset;
             float _FresnelRimPower;
             float _FresnelRimIntensity;
             float _RimMaskSoftness;
             float _RimMaskOffset;
             float4 _RimLightDirection;

             half _LutStrength;
             
             half4 _EnvColor;
             half _EnvLightStrength;
             half4 _EnvRotation;
             half _SpecularRefineRamp;
             half _SpecularRefineIntensity;

             half _ShadowStrength;
             CBUFFER_END
             TEXTURE2D(_AlbedoMap);      SAMPLER(sampler_AlbedoMap);
             TEXTURE2D(_NormalMap);    SAMPLER(sampler_NormalMap);
             TEXTURE2D(_RMOMap);       SAMPLER(sampler_RMOMap);
             TEXTURE2D(_RampMap);      SAMPLER(sampler_RampMap);
             TEXTURE2D(_EmissionMap);  SAMPLER(sampler_EmissionMap);
             TEXTURE2D(_EffectsMap);   SAMPLER(sampler_EffectsMap);
             TEXTURE2D(_LutMap);   SAMPLER(sampler_LutMap);
             TEXTURE2D(_SpecularRefineMap);   SAMPLER(sampler_SpecularRefineMap);
             
             
             Varyings vert(Attributes input)
             {
                 Varyings output = (Varyings)0;
                 VertexPositionInputs vertexInput = GetVertexPositionInputs(input.positionOS.xyz);
                 VertexNormalInputs normalInput = GetVertexNormalInputs(input.normalOS.xyz, input.tangentOS);
                 output.positionWS.xyz = vertexInput.positionWS;
                 output.positionVS = vertexInput.positionVS;

                 output.TBN = float3x3(normalInput.tangentWS, normalInput.bitangentWS, normalInput.normalWS);

                 output.normalWS.xyz = normalInput.normalWS;
                 output.tangentWS = normalInput.tangentWS;

                 output.positionOS = input.positionOS;
                 output.uv0.xy = input.texcoord0;
                 output.uv0.zw = input.texcoord1;
                 output.color = input.color;

                 output.positionCS = TransformWorldToHClip(output.positionWS.xyz);
                 output.shadowCoord = ComputeScreenPos(output.positionCS);//计算屏幕空间坐标
                 
                 return output;
             }

             void frag(Varyings input, out half4 outColor : SV_Target0)
             {
                 //  albedo
                 half4 var_AlbedoMap = SAMPLE_TEXTURE2D(_AlbedoMap, sampler_AlbedoMap, input.uv0.xy);
                 half3 albedoColor = var_AlbedoMap.rgb * _AlbedoColor.rgb;
                 
 
                 //  metallic roughness ao reflectivity
                 half4 var_RMOMap = SAMPLE_TEXTURE2D(_RMOMap, sampler_RMOMap, input.uv0.xy);
                 half metallic = var_RMOMap.r * _MetallicStrength;
                 half roughness = (1.0 - var_RMOMap.a) * _RoughnessStrength;
                 half ao = lerp(1.0, var_RMOMap.b, _OcclusionStrength);
                 float reflectivity = var_RMOMap.g;
 
                 //  normal
                 half3 normalTS = UnpackNormalScale(SAMPLE_TEXTURE2D(_NormalMap, sampler_NormalMap, input.uv0.xy), _NormalStrength);
                 float3 normalWS = TransformTangentToWorld(normalTS, input.TBN);
                 
                 //  emissive
                 half4 var_EmissionMap = SAMPLE_TEXTURE2D(_EmissionMap, sampler_EmissionMap, input.uv0.xy);
                 half3 emissiveColor = var_EmissionMap.rgb * _EmissionColor.rgb;

                 //  effects
                 half3 effectsColor = 0.0;
                 #ifdef _EFFECTSENABLE_ON
                 half4 var_EffectsMap = SAMPLE_TEXTURE2D(_EffectsMap, sampler_EffectsMap, input.uv0.zw);
                 effectsColor = var_EffectsMap.rgb * _EffectsColor.rgb;
                 #endif
                 
                 Light mainLight = GetMainLight(TransformWorldToShadowCoord(input.positionWS.xyz));
                 float3 viewDirWS = GetWorldSpaceNormalizeViewDir(input.positionWS.xyz);
                 
                 float3 halfDir = normalize(viewDirWS + mainLight.direction);
                 float3 reflectDir = normalize(reflect(-viewDirWS, normalWS.xyz));

                 float noh = saturate(dot(normalWS.xyz, halfDir));//高光
                 float nol = saturate(dot(normalWS.xyz, mainLight.direction));//慢
                 float nov = saturate(dot(normalWS.xyz, viewDirWS));//菲涅尔效应、边缘光强度

                 // Shadow
                 half3 screenShadow = saturate(SamplePerObjectScreenSpaceShadowmap(input.shadowCoord));
                 half3 shadow = min(lerp(half3(1.0, 1.0, 1.0), screenShadow, _ShadowStrength), 1.0);
 
                 //  ramp
                 half rampUV_nol = nol * 0.5 + 0.5;
                 half4 rampColor_nol = SamplerRampMap(_RampMap, sampler_RampMap, rampUV_nol, _RampStrength);
                  
                 // ----------------------- direct diffuse start直接漫反射 -----------------------
                 half3 albedoColor_Light = pow(saturate(albedoColor), _AlbedoStrength);
                 half3 albedoColor_Dark = albedoColor_Light * _AlbedoDarkStrength;
                 #ifdef _APPLYLUTENABLE_ON
                 albedoColor_Dark = lerp(albedoColor, ApplyLut2D(TEXTURE2D_ARGS(_LutMap, sampler_LutMap), albedoColor, 32), _LutStrength) * _AlbedoDarkStrength;
                 #endif
                 float luma = dot(albedoColor_Dark, float3(0.2126, 0.7152, 0.0722));
                 albedoColor_Dark = lerp(luma.xxx, albedoColor_Dark, _AlbedoDarkSaturation);
                 
                 half3 brdfDiffuse_Light = albedoColor_Light * OneMinusReflectivityMetallic(metallic);
                 half3 brdfDiffuse_Dark = albedoColor_Dark * OneMinusReflectivityMetallic(metallic);
                  
                 float lightAndDarkRamp = min(min(shadow, ao), rampColor_nol.a);
                 half3 brdfDiffuse = lerp(brdfDiffuse_Dark, brdfDiffuse_Light, ao) * rampColor_nol.rgb;
                 
                 half3 baseDiffuseLighting = brdfDiffuse * INV_PI * nol * mainLight.color * shadow;
                 
                 // ----------------------- direct specular start 直接高光----------------------
                 float roughness2  = max(roughness * roughness, HALF_MIN_SQRT);
                 half3 brdfSpecular = kDielectricSpec.rgb * reflectivity.rrr + metallic * (albedoColor.rgb - reflectivity.xxx * 0.04);

                 float d = D_DistributionGGX_Endfield(noh, roughness);
                 float g = G_GeometrySmith_Endfield(nov, nol, roughness);
                 
                 #ifdef _SPECULARREFINEENABLE_ON
                 brdfSpecular = lerp(brdfSpecular, GetSpecularRefine(_SpecularRefineMap, sampler_SpecularRefineMap, brdfSpecular,metallic, roughness, noh), _SpecularRefineIntensity);
                 #endif
                 
                 float3 f = F_FrenelSchlick_Direct_Endfield(nov, brdfSpecular);
                 float3 numerator = d * g * f;
                 float denominator = max(4 * nov * nol, 0.001);

                //  float denom = noh * noh * (roughness2 - 1.0) + 1.0;
                // float D_raw = roughness2 / (denom * denom);
                // float specRampPartial = D_raw * (roughness2 + 1e-4);
                // float specRampU = specRampPartial;
                // float specRampV = (1.0 - metallic) * roughness;
                // float4 var_SpecularRamp = SAMPLE_TEXTURE2D(_SpecularRefineMap, sampler_SpecularRefineMap, float2(specRampU, specRampV));
                 
                 half3 baseSpecularLighting = numerator / denominator * mainLight.color * shadow;

                
                 
                 // ----------------------- indirect diffuse start 间接漫反射-----------------------
                 real3 radianceSH = SampleSH(normalWS.xyz);
                 half3 indirectDiffuseLighting = saturate(radianceSH * brdfDiffuse);
                
                 // ---------------------- indirect specular start 间接高光-----------------------
                 float3 specularLD = GlossyEnvironmentReflection(RotateDirection(reflectDir, _EnvRotation.xyz), roughness, ao);
                 specularLD = dot(specularLD, float3(0.2126, 0.7152, 0.0722));
                 real3 specularDFG = EnvBRDFApprox_Endfield(brdfSpecular, roughness, nov);
                 float3 indirectSpecularLighting = clamp(0.0, 10.0, specularLD) * specularDFG * _EnvColor.rgb * _EnvLightStrength;
                 float3 indirectLight = indirectDiffuseLighting + indirectSpecularLighting;
                 
                 // RimLight 边缘光
                 float combinedRimMask = GetRimLightMask(_RimMaskOffset, _RimMaskSoftness, input.positionWS.x, normalWS, _RimLightDirection.xyz);
                 half3 rimLighColor = GetRimLightColor(_FresnelRimOffset, _FresnelRimPower, _FresnelRimIntensity, normalWS, viewDirWS,
                     _DepthRimOffset, _DepthRimIntensity, _DepthRimLerp, input.positionVS, input.positionCS, albedoColor_Light, _RimLightColor.rgb,
                     ao, shadow, combinedRimMask);
                 
                 //float3 ibl = saturate(GetIBL(roughness, roughness2, nov, brdfSpecular, reflectDir));
                
                 half3 color = baseDiffuseLighting + baseSpecularLighting + indirectDiffuseLighting + indirectSpecularLighting + emissiveColor + effectsColor + rimLighColor;

                 outColor = ApplyDebugOutput(half4(color, 1.0), half4(albedoColor, 1.0), normalWS, metallic.rrrr, roughness.rrrr, emissiveColor + effectsColor,
                                            baseDiffuseLighting, baseSpecularLighting, indirectDiffuseLighting, indirectSpecularLighting,
                                            rimLighColor, ao, screenShadow);
                 //outColor = half4(brdfSpecular * var_SpecularRamp,1);
                 //outColor = specRampV;
             }
             ENDHLSL
         }

         Pass
         {
            Name "Outline"
            Tags { "LightMode" = "SRPDefaultUnlit" }
            
            Cull Front  // 剔除正面，只渲染背面（外扩部分）
            ZWrite On
            ZTest LEqual
            
            Stencil
            {
                Ref 1
                Comp NotEqual
            }
            
            //Blend SrcAlpha OneMinusSrcAlpha
            
            HLSLPROGRAM
            #pragma vertex OutlineVertex
            #pragma fragment OutlineFragment
            
            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
            
            struct Attributes
            {
                float4 positionOS : POSITION;
                float3 normalOS   : NORMAL;
                float4 color      : COLOR;
                float2 texcoord0         : TEXCOORD0;
                half4 texcoord1   : TEXCOORD1;
            };
            
            struct Varyings
            {
                float4 positionCS : SV_POSITION;
                float4 color      : COLOR;
                float2 uv0         : TEXCOORD0;
                float4 uv1         : TEXCOORD2;
            };
            
            CBUFFER_START(UnityPerMaterial)
            half4 _AlbedoColor;
            half _AlbedoStrength;
            half _AlbedoDarkStrength;
            half _AlbedoDarkSaturation;
            half _NormalStrength;
            half _NormalStrength_HL;
            half _RampStrength;

            half4 _AnisotropicMap_ST;
            half4 _HairLine_ST;
            half4 _HairLineColor;
            half _AnisotropicStrength;
            half _AnisotropicOffset;
            half _AnisotropicRange;
            half _CutOffset;

            half4 _SpecularColor;
            half _SpecularRefineOffset_U;
            half _SpecularRefineOffset_V;
            
            half4 _DepthRimColor;
            float _DepthRimOffset;
            float _DepthRimIntensity;
            half _DepthRimLerp;
            half4 _RimLightColor;
            half _FresnelRimOffset;
            float _FresnelRimPower;
            float _FresnelRimIntensity;
            float _RimMaskSoftness;
            float _RimMaskOffset;
            float4 _RimLightDirection;

            half _LutStrength;

            half _AOStrength;
            
            half4 _EnvColor;
            half _EnvLightStrength;
            half4 _EnvRotation;
            half _SpecularRefineRamp;
            half _SpecularRefineIntensity;
            half4 _DoubleSpecularColor;
            half _DoubleSpecularRange;

            half4 _OutlineColor;
            half _OutlineWidth;
            half _OutlineWidthMapStrength;
            half _OutlineZOffset;

            half _Alpha;
            half _Test;

            float3 _FaceForward;
            float3 _FaceRight;
            float3 _FaceUp;
            float4 _HeadPosition;
            CBUFFER_END
            
            TEXTURE2D(_AlbedoMap);        SAMPLER(sampler_AlbedoMap);
            TEXTURE2D(_OutLineMask);      SAMPLER(sampler_OutLineMask);
            
            Varyings OutlineVertex(Attributes input)
            {
                Varyings output = (Varyings)0;
                
                half widthMap = SAMPLE_TEXTURE2D_LOD(_OutLineMask, sampler_OutLineMask, input.texcoord0, 0).r;
                half outlineWidth = (_OutlineWidth * 0.001) * lerp(1.0, widthMap, _OutlineWidthMapStrength);
                
                float3 normalOS = input.normalOS;
                
                float3 positionOS = input.positionOS.xyz + normalOS * outlineWidth;
                
                float4 positionCS = TransformObjectToHClip(positionOS);
                
                output.positionCS = positionCS;
                output.uv0.xy = input.texcoord0;
                output.color = input.color;
                
                return output;
            }
            
            half4 OutlineFragment(Varyings input) : SV_Target
            {
                half4 albedoColor = SAMPLE_TEXTURE2D(_AlbedoMap, sampler_AlbedoMap, input.uv0.xy);
                return half4(_OutlineColor.rgb * albedoColor.rgb, max(albedoColor.a, _Alpha));
            }
            ENDHLSL
        }

         Pass
         {
             Tags
             { "LightMode" = "ShadowCaster" }
 
             HLSLPROGRAM
             #pragma vertex ShadowCasterVertex
             #pragma fragment ShadowCasterFragment
 
             #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
             #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl"
 
             struct Attributes
             {
                 float4 positionOS   : POSITION;
                 float3 normalOS     : NORMAL;
             };
 
             struct Varyings
             {
                 float4 positionCS   : SV_POSITION;
             };
             
             Varyings ShadowCasterVertex(Attributes v)
             {
                 Varyings o;
                 float3 positionWS = TransformObjectToWorld(v.positionOS.xyz);
                 float3 normalWS = TransformObjectToWorldNormal(v.normalOS);
                 o.positionCS = TransformWorldToHClip
                          (ApplyShadowBias(positionWS, normalWS, _MainLightPosition.xyz));
                 #if UNITY_REVERSED_Z
                     o.positionCS.z = min(o.positionCS.z, UNITY_NEAR_CLIP_VALUE);
                 #else
                     o.positionCS.z = max(o.positionCS.z, UNITY_NEAR_CLIP_VALUE);
                 #endif
                 return o;
             }
 
             half4 ShadowCasterFragment(Varyings i) : SV_TARGET
             {
                 return 0;
             }
             ENDHLSL
         }

         Pass
         {
            Name "DepthOnly"
            Tags { "LightMode" = "DepthOnly" }

            Stencil
            {
                Ref [_StencilRef]
                Comp Always
                Pass Replace
            }

            ZWrite On
            ZTest LEqual
            ColorMask R
            Cull Back

            HLSLPROGRAM
            #pragma target 2.0
            #pragma vertex DepthOnlyVertex
            #pragma fragment DepthOnlyFragment

            #include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"

            TEXTURE2D(_BaseColor);
            SAMPLER(sampler_BaseColor);

            CBUFFER_START(UnityPerMaterial)
                float4 _BaseColor_ST;
                half _AlphaClip;
            CBUFFER_END

            struct DepthOnlyAttributes
            {
                float4 positionOS : POSITION;
                float2 uv : TEXCOORD0;
            };

            struct DepthOnlyVaryings
            {
                float4 positionCS : SV_POSITION;
                float2 uv : TEXCOORD0;
            };

            DepthOnlyVaryings DepthOnlyVertex(DepthOnlyAttributes input)
            {
                DepthOnlyVaryings output;
                output.positionCS = TransformObjectToHClip(input.positionOS.xyz);
                output.uv = TRANSFORM_TEX(input.uv, _BaseColor);
                return output;
            }

            half DepthOnlyFragment(DepthOnlyVaryings input) : SV_TARGET
            {
                half alpha = SAMPLE_TEXTURE2D(_BaseColor, sampler_BaseColor, input.uv).a;
                clip(alpha - _AlphaClip);
                return input.positionCS.z;
            }
            ENDHLSL
        }
     } 
} 
 